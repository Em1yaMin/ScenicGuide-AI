# Dify API Configuration
# 阶段4 收官（船长决策 2026-08-06，见 doc/dify-dependency-audit.md）：
# - 对话双轨回落保留：DIFY_API_URL/DIFY_API_KEY（dialogue.py 兜底 + 轮询抓取）
# - 量化评估已本地 LLM（app/services/evaluation_service.py，LLM_* 配置 opencode-go），
#   DIFY_WORKFLOW_API_KEY 已移除；推荐问句已本地 LLM（阶段3 T3），DIFY_RECOMMEND_WORKFLOW_API_KEY 已移除
DIFY_API_URL=http://your-dify-server/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx
# DIFY_LIGHT4AI_USER：轮询/补拉用户（逗号分隔可多个；留空则轮询空转）。
# 2026-08-11 迁移实测旧 Dify 服务器数据 user=visitor（见 doc/dify-data-migration-report.md §6）
DIFY_LIGHT4AI_USER=

# Application
APP_NAME=景区导览AI数字人
DEBUG=false
# 运行环境标识（批次8 C7 多环境配置）：dev=本机开发 / staging=VM 联调演示 /
# prod=正式部署；三档差异与切换指引见 doc/deployment-environments.md
APP_ENV=dev

# Database
DATABASE_URL=sqlite+aiosqlite:///./digital_human.db

# CORS whitelist (comma-separated origins; leave empty only for the demo default of
# localhost/127.0.0.1/192.168.16.132 x 5173/8001/3000 - production MUST set real domains)
CORS_ORIGINS=
# Allow credentialed cross-origin requests (default true, needed for JWT Bearer passthrough).
# When true, CORS_ORIGINS must NOT contain "*" (Starlette echoes any origin = fully open).
CORS_ALLOW_CREDENTIALS=true

# OpenAI（用于 LangChain AI 运营分析，不配置时分析接口回退到纯 DB 统计）
# 船长决策 2026-08-06：当前部署单用 opencode-go 端点（同对话 LLM 的 key），
# 模型用 opencode-go 支持的 deepseek-v4-flash（默认 gpt-4o-mini 仅作通用示例）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini

# 对话 LLM（阶段1 接入层，与 OPENAI_*/EMBEDDING_* 完全独立，详见 digitalHumanApi/.env.example）
# 主端点 opencode-go（deepseek-v4-flash）
# 备用端点（船长决策 2026-08-06）：备用同主端点 opencode-go——opencode 服务本质转发
#   DeepSeek 官方 key，无需另配官方备用（此前示例默认官方 DeepSeek API）
LLM_API_BASE=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-your-opencode-go-api-key
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_API_BASE=https://opencode.ai/zen/go/v1
LLM_FALLBACK_API_KEY=sk-your-opencode-go-api-key
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7

# Admin API token for management endpoints (knowledge base, etc.) - always treated as admin role
ADMIN_API_TOKEN=your-admin-api-token
# RBAC role mapping (optional): "token1=admin,token2=operator", comma-separated;
# bare tokens (no "=") are treated as admin; ADMIN_TOKENS takes precedence over ADMIN_API_TOKEN.
# Delete operations (knowledge delete / memory delete) require the admin role (operator gets 403).
ADMIN_TOKENS=
# Admin account/password login (batch 9: replaces the X-Admin-Token input form).
# POST /api/v1/admin/login issues an admin JWT; management endpoints accept either
# Authorization Bearer admin JWT or X-Admin-Token. Defaults are demo credentials
# (documented in README); change them in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# Auth endpoint rate limiting (batch 6 C3, in-process, only /api/v1/auth/login|register|guest):
# sliding-window failures per IP+account -> cooldown; during cooldown returns 429 + Retry-After.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_COOLDOWN_SECONDS=900
# Guest endpoint (no failure scenario): per-IP fixed-window frequency cap (per minute)
AUTH_GUEST_MAX_PER_MINUTE=30

# Admin agent (batch 6): TTL (seconds) of two-phase delete confirmations (default 120)
ADMIN_AGENT_CONFIRM_TTL_SECONDS=120

# JWT user auth (register/login/guest token). REQUIRED in production:
# set JWT_SECRET to a random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# If empty, the backend generates an ephemeral secret that invalidates all tokens on restart.
JWT_SECRET=
# User token lifetime in minutes (default 1440 = 24h)
JWT_EXPIRES_MINUTES=1440
# Guest token lifetime in minutes (default 30)
GUEST_TOKEN_EXPIRES_MINUTES=30

# AMAP Web service key (batch 8 B3: GPS geocoding / route planning, see doc/amap-gps-api.md)
# Missing key degrades to amap_not_configured error code in dialogue tools (never blocks chat).
AMAP_WEB_KEY=your-amap-web-key

# NOTE: This .env.example is for Docker Compose deployment.
# For local non-Docker development, use digitalHumanApi/.env.example instead.
