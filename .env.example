# Dify API Configuration
DIFY_API_URL=http://your-dify-server/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx
DIFY_WORKFLOW_API_KEY=app-xxxxxxxxxxxxxxxx
DIFY_RECOMMEND_WORKFLOW_API_KEY=app-xxxxxxxxxxxxxxxx

# Application
APP_NAME=景区导览AI数字人
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./digital_human.db

# CORS (comma-separated origins, leave empty for production same-origin via nginx)
CORS_ORIGINS=

# NOTE: This .env.example is for Docker Compose deployment.
# For local non-Docker development, use digitalHumanApi/.env.example instead.
