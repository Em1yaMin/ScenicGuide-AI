# Dify API Configuration
DIFY_API_URL=http://your-dify-server/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx
DIFY_WORKFLOW_API_KEY=app-xxxxxxxxxxxxxxxx
DIFY_RECOMMEND_WORKFLOW_API_KEY=app-xxxxxxxxxxxxxxxx

# Application
APP_NAME=景区导览AI数字人
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./digital_human.db

# CORS (comma-separated origins, leave empty for production same-origin via nginx)
CORS_ORIGINS=

# OpenAI（用于 LangChain AI 运营分析）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini

# Admin API token for management endpoints (knowledge base, etc.)
ADMIN_API_TOKEN=your-admin-api-token

# JWT user auth (register/login/guest token). REQUIRED in production:
# set JWT_SECRET to a random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# If empty, the backend generates an ephemeral secret that invalidates all tokens on restart.
JWT_SECRET=
# User token lifetime in minutes (default 1440 = 24h)
JWT_EXPIRES_MINUTES=1440
# Guest token lifetime in minutes (default 30)
GUEST_TOKEN_EXPIRES_MINUTES=30

# NOTE: This .env.example is for Docker Compose deployment.
# For local non-Docker development, use digitalHumanApi/.env.example instead.
