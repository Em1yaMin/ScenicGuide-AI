# FastAPI 应用配置
APP_NAME=景区导览AI数字人
DEBUG=false

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./digital_human.db

# CORS 白名单（批次6 C3 安全加固，逗号分隔多个 origin）
# 默认值（未配置/留空时）：localhost / 127.0.0.1 / 192.168.16.132 × 5173/8001/3000
# （演示环境本机宿主机跨端口访问不锁死；生产务必显式收紧为实际部署域名）
# 注意：CORS_ALLOW_CREDENTIALS=true（默认，JWT Bearer 透传需要）时白名单不能含
# 通配符 *（Starlette 会把 * 退化为回显任意 origin = 全放开，启动会直接报错）
CORS_ORIGINS=http://localhost:5173,http://localhost:8001,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:3000,http://192.168.16.132:5173,http://192.168.16.132:8001,http://192.168.16.132:3000
# 是否允许跨域携带凭证（Cookie/Authorization），默认 true；仅当显式关闭时才允许
# CORS_ORIGINS 使用通配符 *（生产无凭证场景可选）
CORS_ALLOW_CREDENTIALS=true

# 认证端点限流（批次6 C3 安全加固，进程内实现零新依赖，见 app/core/rate_limiter.py）
# 仅作用于 /api/v1/auth/login|register|guest（防爆破），不误伤对话等正常接口；
# 按 IP + 账号双维度：滑动窗口内失败次数达到阈值后进入冷却期，冷却期内 429
# （detail 含剩余秒数 + Retry-After 头，前端可展示）；登录成功自动清零防误伤。
AUTH_RATE_LIMIT_ENABLED=true
# 窗口内最大失败次数（默认 5 次）
AUTH_RATE_LIMIT_MAX_FAILURES=5
# 失败计数滑动窗口（秒，默认 60）
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# 触发限流后的冷却期（秒，默认 900 = 15 分钟）
AUTH_RATE_LIMIT_COOLDOWN_SECONDS=900
# guest 端点（无失败场景）纯 IP 频率上限：次/分钟（默认 30，防 token 刷取）
AUTH_GUEST_MAX_PER_MINUTE=30

# Dify API（阶段4 收官：Dify 依赖面盘点见 doc/dify-dependency-audit.md）
# 用途归属：
#   DIFY_API_URL / DIFY_API_KEY —— 对话双轨回落（dialogue.py 兜底，保留）+ 对话数据轮询抓取（polling.py，历史数据接口）
#   DIFY_LIGHT4AI_USER —— 轮询用户（polling.py/backfill.py，逗号分隔可多个；留空则轮询空转）
# 已移除：DIFY_RECOMMEND_WORKFLOW_API_KEY（推荐问句已本地 LLM 生成，阶段3 T3）
# 已移除：DIFY_WORKFLOW_API_KEY（量化评估已本地 LLM，阶段4——app/services/evaluation_service.py，LLM_* 配置）
DIFY_API_URL=https://your-dify.example.com/v1
DIFY_API_KEY=your-chat-agent-api-key
DIFY_LIGHT4AI_USER=your-light4ai-user

# OpenAI（用于 LangChain AI 运营分析）
# 不配置时分析接口回退到纯 DB 统计
# 船长决策 2026-08-06：当前部署单用 opencode-go 端点（同对话 LLM 的 key），
# 模型用 opencode-go 支持的 deepseek-v4-flash（默认 gpt-4o-mini 仅作通用示例）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini

# 对话 LLM（对话主链路 LangChain agent 的模型接入层，见 app/core/llm.py）
# 与 Embedding（EMBEDDING_*）及运营分析（OPENAI_*）的配置完全独立
# 主端点：opencode-go（OpenAI 兼容，https://opencode.ai/zen/go/v1，模型 deepseek-v4-flash）
# 备用端点（船长决策 2026-08-06）：备用同主端点 opencode-go——opencode 服务本质转发
#   DeepSeek 官方 key，无需另配官方备用（此前示例默认官方 DeepSeek API）
# 不配置任何 LLM key 时 get_chat_llm() 抛 LLMConfigError（对话链路已接入：chat_agent 捕获异常回落 Dify）
# 兼容性结论（DeepSeek reasoning_content 思考格式）见 doc/llm-adapter-smoke-test.md：
#   - reasoning_content 由 langchain-openai 自动剥离，无需自定义处理
#   - max_tokens 经工厂 extra_body 注入原生 max_tokens 字段（langchain 默认发 max_completion_tokens，DeepSeek 不识别）
LLM_API_BASE=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-your-opencode-go-api-key
LLM_MODEL=deepseek-v4-flash
# 备用同主端点（船长决策 2026-08-06）
LLM_FALLBACK_API_BASE=https://opencode.ai/zen/go/v1
LLM_FALLBACK_API_KEY=sk-your-opencode-go-api-key
LLM_FALLBACK_MODEL=deepseek-v4-flash
# 对话默认采样温度（可被调用方覆盖），默认 0.7
LLM_TEMPERATURE=0.7

# 对话引擎（阶段1 T2：LangChain agent 主链路，Dify 兜底，见 app/services/chat_agent.py）
# langchain: 默认，LangChain agent（LLM_* 配置 + 本地工具：知识检索/景点/路线/推荐），
#            异常自动回落 Dify（演示不翻车）
# dify: 强制走 Dify Chat Agent（原链路，RAG 预检索 + Dify）
# 对话接口 streaming=true 时返回 SSE 流式事件（agent 步骤 + 逐字回答，阶段1 T3，
# 见 README「SSE 流式对话」）；流式/非流式共用本开关，无新增配置项
DIALOGUE_ENGINE=langchain

# 阶段3 T1 双模式（方案B：简单问答走快速路径，复杂任务走规划路径）
# **A3 起仅对已弃用的 chat_agent 双模式链路生效**（对话主链路已切换到
# deepagents 装配层，无条件意图分流：复杂任务注入 prompt 级规划指令）；
# 主链路不读取本开关，勿依赖其作为生产回退开关。
# true（默认）：弃用链路按意图分类分流——简单（单工具可答，如「开放时间」「在哪」）
# 走现有 create_agent 快速路径（零延迟增加）；复杂（多步骤意图，如「规划灵山
# 一日游，带老人小孩，喜欢拍照」）走 LangGraph 规划图（规划→多步执行→总结，
# SSE 步骤可视化）；分类失败/规划路径异常自动降级快速路径，再由路由层兜底 Dify
# false：弃用链路全部走快速路径，行为与阶段2 完全一致
AGENT_DUAL_MODE=true

# A4 成本/速度调优（deepagents 装配层组合拳，见 doc/deepagents-tuning.md）
# 1) 单轮工具调用上限（ToolCallLimitMiddleware）：超限后拦截并以错误结果回给
#    模型，模型基于已有信息直接作答（优雅降级，不报错、不回落）
AGENT_MAX_TOOL_CALLS=15
# 2) 工具结果归一化缓存（同 query 不重查；归一化去空白/标点/大小写）
AGENT_TOOL_CACHE_ENABLED=true
# 静态数据工具（景点/路线）缓存 TTL（秒）：app/data/ 静态 JSON，长缓存安全
AGENT_TOOL_CACHE_TTL_STATIC=3600
# 知识检索工具缓存 TTL（秒）：知识库 CRUD 变更会重建索引并立即失效缓存
# （短 TTL 兜底 + 索引重建即时失效，见 app/services/deepagents/tool_cache.py）
AGENT_TOOL_CACHE_TTL_KNOWLEDGE=300
# 3) 长会话上下文压缩（SummarizationMiddleware 引擎，回答后触发）：
#    历史超过 AGENT_COMPACT_TRIGGER_MESSAGES 条（≈12 轮）时压缩早期轮次
#    为摘要，保留最近 AGENT_COMPACT_KEEP_MESSAGES 条完整消息（≈5 轮）
AGENT_COMPACT_ENABLED=true
AGENT_COMPACT_TRIGGER_MESSAGES=24
AGENT_COMPACT_KEEP_MESSAGES=10

# RAG 向量化 Embedding（与上方 OPENAI_* 完全独立；见 app/core/embedding.py）
# EMBEDDING_API_STYLE 控制请求体格式（2026-08-07 起支持 Qwen/DashScope 迁移）：
#   minimax（默认，兼容旧配置）: Minimax 原生格式（实测 embo-01）——请求体
#     {"model", "texts", "type"}（type=query/db，embed_query 传 query、文档索引传 db），
#     响应 {"vectors": [...]}；文档: https://platform.minimaxi.com/document/embeddings
#   openai: OpenAI 兼容格式——请求体 {"model", "input": [...]}，响应
#     {"data": [{"embedding": [...]}]}；DashScope compatible-mode 实测（2026-08-07）
#     模型 qwen3.7-text-embedding（1024 维），端点 https://dashscope.aliyuncs.com/compatible-mode/v1
# 不配置 EMBEDDING_API_KEY 时自动降级为本地 TF-IDF 向量化（日志告警，链路不中断）
EMBEDDING_API_BASE=https://api.minimaxi.com/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=embo-01
EMBEDDING_API_STYLE=minimax

# 管理员 API Token（管理后台接口认证，X-Admin-Token 请求头）
# 既有配置，恒视为 admin 角色（向后兼容，现有部署行为不变）
ADMIN_API_TOKEN=your-admin-api-token
# 管理端 RBAC 角色映射（批次6 C3 安全加固，可选）："token1=admin,token2=operator"
# 逗号分隔；不带 = 的裸 token 视为 admin；ADMIN_TOKENS 命中优先于 ADMIN_API_TOKEN。
# 角色分级：admin 全部操作；operator 查询/公告发布等常规操作，删除类敏感操作
# （知识库删除/记忆删除）403。前端暂不改（仍传同一 token），部署时如只需单
# 角色可不配本项。
ADMIN_TOKENS=your-admin-token=admin,your-operator-token=operator

# 管理员 agent（批次6 B4）：删除类工具两阶段二次确认的待确认项 TTL（秒）
# 首次删除调用仅登记待确认项，短 TTL 过期后需重新发起（默认 120）
ADMIN_AGENT_CONFIRM_TTL_SECONDS=120

# JWT 用户认证（注册/登录/游客 token，见 app/core/security.py）
# JWT_SECRET: 生产环境必须设置为随机长字符串
#   （如 `python -c "import secrets; print(secrets.token_urlsafe(48))"`）；
#   留空时后端启动会生成随机临时密钥，重启后已签发 token 失效（仅限开发）
JWT_SECRET=
# 登录用户 token 有效期（分钟），默认 1440（24 小时）
JWT_EXPIRES_MINUTES=1440
# 游客 token 有效期（分钟），短期即可，默认 30
GUEST_TOKEN_EXPIRES_MINUTES=30

# 短期记忆持久化（阶段2 T1：会话历史 SQLite 落盘 + 进程内 TTL 缓存，见 app/core/memory_store.py）
# 登录用户与游客均享短期记忆（会话级，按 conversation_id）；重启后同会话可恢复多轮上下文
# 存储文件独立于主库 digital_human.db（标准库 sqlite3，无额外依赖）
MEMORY_DB_PATH=memory_store.db
# 会话 TTL（天）：滑动窗口，每次对话刷新过期时间；默认 7 天
MEMORY_TTL_DAYS=7
# 过期会话清理周期（秒）：后台任务定期删除过期会话（启动时立即清理一次），默认 1 小时
MEMORY_CLEANUP_INTERVAL_SECONDS=3600

# 本地 RAG 知识库（可选，默认值见 app/core/rag.py / app/services/rag_service.py）
# 命名空间: knowledge（知识库条目）/ documents（doc/景区知识库/ 文档）/ user_memory（用户长期记忆）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MAX_CONTEXT_LEN=2000

# 长期记忆（阶段2 T2：对话完成后提取用户事实/偏好，写入 user_memory 向量库，
# 见 app/services/memory_service.py 与 doc/long-term-memory.md）
# 记忆条目 schema 与 T3 契约见 doc/long-term-memory.md（变更须同步文档）
# MEMORY_ENABLED: 记忆提取总开关（默认 true；游客/匿名永不写记忆）
MEMORY_ENABLED=true
# 每用户记忆条数上限（超限淘汰 timestamp 最旧条目，防记忆无限膨胀），默认 200
MEMORY_MAX_PER_USER=200
# 长期记忆检索注入（阶段2 T3）：对话首轮按 user 检索用户画像注入 agent 上下文
# MEMORY_INJECT_ENABLED: 注入总开关（默认 true；游客无记忆天然不注入；检索异常/无记忆静默降级）
MEMORY_INJECT_ENABLED=true
# 注入的记忆最大时效（天）：超过视为陈旧事实不注入（防过时信息误导），默认 180
MEMORY_MAX_AGE_DAYS=180

# 高德 Web 服务 Key（批次8 B3：GPS 地理编码/路径规划，见 doc/amap-gps-api.md）
# 演示主推「描述位置 → 地理编码 → 路径规划 → 地图展示」；坐标全部来自高德
# API（结构化零幻觉）。未配置时不阻断对话：对话工具返回 amap_not_configured
# 错误码。申请地址 https://console.amap.com/（Web 服务 key）。
# 注意：与前端地图渲染的 JS API key（VITE_AMAP_JS_KEY）是两套独立凭据。
AMAP_WEB_KEY=your-amap-web-key

# SSH 远程服务器
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your-password

# ── LLM token 记账（批次7 C5，见 doc/usage-tracking.md） ──
# 总开关：关闭后 llm.py 工厂不再包装埋点模型，所有调用零额外开销
USAGE_TRACKING_ENABLED=true
# 后台批量写库周期（秒）：进程内队列由 flush 循环定时落库（默认 5），关闭应用时兜底 flush
USAGE_FLUSH_INTERVAL_SECONDS=5
# 进程内队列上限：超出后立即兜底落库（默认 2000，防内存膨胀）
USAGE_QUEUE_MAX_SIZE=2000
# 流式调用是否请求 usage（stream_options.include_usage）：opencode-go/DeepSeek 官方均支持；
# 若部署到不兼容的网关可关闭（关闭后流式调用拿不到 usage，无 token 明细且不记账）
USAGE_STREAM_USAGE=true
# 模型单价表（可选，opencode-go 订阅制可留空只记 token 不记钱）：
# 格式 "模型:每百万输入tokens价,每百万输出tokens价"（元），多项分号分隔
# 例：MODEL_PRICES=deepseek-v4-flash:1.0,2.0;deepseek-chat:1.0,2.0
MODEL_PRICES=
