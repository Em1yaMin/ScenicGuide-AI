# FastAPI 应用配置
APP_NAME=景区导览AI数字人
DEBUG=false

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./digital_human.db

# CORS（开发环境前端地址，多个用英文逗号分隔）
CORS_ORIGINS=http://localhost:5173

# Dify API
# DIFY_API_KEY: Chat Agent 应用的 Key（用于 /conversations、/messages 拉对话）
# DIFY_WORKFLOW_API_KEY: Workflow 应用的 Key（用于 /workflows/run 触发量化评估）
# DIFY_LIGHT4AI_USER: light4ai 调 Dify 时传的 user 字段（固定值，所有对话归此 user）
DIFY_API_URL=https://your-dify.example.com/v1
DIFY_API_KEY=your-chat-agent-api-key
DIFY_WORKFLOW_API_KEY=your-workflow-api-key
DIFY_RECOMMEND_WORKFLOW_API_KEY=app-xxxxxxxxxxxxxxxx
DIFY_LIGHT4AI_USER=your-light4ai-user

# OpenAI（用于 LangChain AI 运营分析）
# 不配置时分析接口回退到纯 DB 统计
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini

# 对话 LLM（对话主链路 LangChain agent 的模型接入层，见 app/core/llm.py）
# 与 Embedding（EMBEDDING_*）及运营分析（OPENAI_*）的配置完全独立
# 主端点：opencode-go（OpenAI 兼容，https://opencode.ai/zen/go/v1，模型 deepseek-v4-flash）
# 备用端点：官方 DeepSeek API（主端点不可用/未配置 key 时自动切换）
# 不配置任何 LLM key 时 get_chat_llm() 抛 LLMConfigError（对话链路已接入：chat_agent 捕获异常回落 Dify）
# 兼容性结论（DeepSeek reasoning_content 思考格式）见 doc/llm-adapter-smoke-test.md：
#   - reasoning_content 由 langchain-openai 自动剥离，无需自定义处理
#   - max_tokens 经工厂 extra_body 注入原生 max_tokens 字段（langchain 默认发 max_completion_tokens，DeepSeek 不识别）
LLM_API_BASE=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-your-opencode-go-api-key
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_API_BASE=https://api.deepseek.com/v1
LLM_FALLBACK_API_KEY=sk-your-deepseek-api-key
LLM_FALLBACK_MODEL=deepseek-chat
# 对话默认采样温度（可被调用方覆盖），默认 0.7
LLM_TEMPERATURE=0.7

# 对话引擎（阶段1 T2：LangChain agent 主链路，Dify 兜底，见 app/services/chat_agent.py）
# langchain: 默认，LangChain agent（LLM_* 配置 + 本地工具：知识检索/景点/路线/推荐），
#            异常自动回落 Dify（演示不翻车）
# dify: 强制走 Dify Chat Agent（原链路，RAG 预检索 + Dify）
# 对话接口 streaming=true 时返回 SSE 流式事件（agent 步骤 + 逐字回答，阶段1 T3，
# 见 README「SSE 流式对话」）；流式/非流式共用本开关，无新增配置项
DIALOGUE_ENGINE=langchain

# RAG 向量化 Embedding（Minimax 原生 Embedding API，与上方 OPENAI_* 完全独立）
# 文档: https://platform.minimaxi.com/document/embeddings
# 注意（2026-08-06 联调实测）：当前模型 embo-01 走 Minimax **原生 API 格式**
# （非 OpenAI 兼容）：请求体 {"model", "texts", "type"}（type 为 query/db，
# embed_query 传 query、文档索引传 db），响应 {"vectors": [...]}；
# 不配置 EMBEDDING_API_KEY 时自动降级为本地 TF-IDF 向量化（日志告警，链路不中断）
EMBEDDING_API_BASE=https://api.minimaxi.com/v1
EMBEDDING_API_KEY=your-minimax-api-key
EMBEDDING_MODEL=embo-01

# 管理员 API Token（管理后台接口认证）
ADMIN_API_TOKEN=your-admin-api-token

# JWT 用户认证（注册/登录/游客 token，见 app/core/security.py）
# JWT_SECRET: 生产环境必须设置为随机长字符串
#   （如 `python -c "import secrets; print(secrets.token_urlsafe(48))"`）；
#   留空时后端启动会生成随机临时密钥，重启后已签发 token 失效（仅限开发）
JWT_SECRET=
# 登录用户 token 有效期（分钟），默认 1440（24 小时）
JWT_EXPIRES_MINUTES=1440
# 游客 token 有效期（分钟），短期即可，默认 30
GUEST_TOKEN_EXPIRES_MINUTES=30

# 短期记忆持久化（阶段2 T1：会话历史 SQLite 落盘 + 进程内 TTL 缓存，见 app/core/memory_store.py）
# 登录用户与游客均享短期记忆（会话级，按 conversation_id）；重启后同会话可恢复多轮上下文
# 存储文件独立于主库 digital_human.db（标准库 sqlite3，无额外依赖）
MEMORY_DB_PATH=memory_store.db
# 会话 TTL（天）：滑动窗口，每次对话刷新过期时间；默认 7 天
MEMORY_TTL_DAYS=7
# 过期会话清理周期（秒）：后台任务定期删除过期会话（启动时立即清理一次），默认 1 小时
MEMORY_CLEANUP_INTERVAL_SECONDS=3600

# 本地 RAG 知识库（可选，默认值见 app/core/rag.py / app/services/rag_service.py）
# 命名空间: knowledge（知识库条目）/ documents（doc/景区知识库/ 文档）/ user_memory（用户长期记忆）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MAX_CONTEXT_LEN=2000

# 长期记忆（阶段2 T2：对话完成后提取用户事实/偏好，写入 user_memory 向量库，
# 见 app/services/memory_service.py 与 doc/long-term-memory.md）
# 记忆条目 schema 与 T3 契约见 doc/long-term-memory.md（变更须同步文档）
# MEMORY_ENABLED: 记忆提取总开关（默认 true；游客/匿名永不写记忆）
MEMORY_ENABLED=true
# 每用户记忆条数上限（超限淘汰 timestamp 最旧条目，防记忆无限膨胀），默认 200
MEMORY_MAX_PER_USER=200
# 长期记忆检索注入（阶段2 T3）：对话首轮按 user 检索用户画像注入 agent 上下文
# MEMORY_INJECT_ENABLED: 注入总开关（默认 true；游客无记忆天然不注入；检索异常/无记忆静默降级）
MEMORY_INJECT_ENABLED=true
# 注入的记忆最大时效（天）：超过视为陈旧事实不注入（防过时信息误导），默认 180
MEMORY_MAX_AGE_DAYS=180

# SSH 远程服务器
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your-password
