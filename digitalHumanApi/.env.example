# =============================================================================
# 景区导览 AI 数字人 — 后端环境配置模板（digitalHumanApi/.env.example）
#
# 使用方式：
#   1. 复制本文件为 digitalHumanApi/.env 后按环境填写（.env 已被 gitignore 不入库）
#   2. 本文件按功能分区组织，每个变量标注适用环境【适用：...】：
#        dev     = 本机开发（默认档位，大部分变量可用默认值/占位符）
#        staging = VM 联调演示（演示环境 192.168.16.132 的局域网部署）
#        prod    = 正式部署（生产环境，凭据与安全参数必须显式配置）
#   3. 三档环境的完整差异说明与切换指引见 doc/deployment-environments.md
#
# 环境覆盖机制：config.py 的 Settings 直接读取进程环境变量（os.environ），
#   .env 文件在启动时加载（load_dotenv override=True，.env 优先于 shell 环境）；
#   Docker Compose 部署经根目录 docker-compose.yml 的 environment 透传。无需
#   改代码即可按环境覆盖任意变量——多环境差异只体现在配置文件上。
# =============================================================================

# ─────────────────────────────── 一、核心 ───────────────────────────────
# 运行环境标识（批次8 C7 多环境配置）：dev=本机开发 / staging=VM 联调演示 /
# prod=正式部署。供启动日志与健康检查（GET /api/v1/health 返回 app_env）透出，
# 便于运维区分当前档位；非法值（大写/别名/笔误）启动即报错防误配。
# 【适用：全部（必填，三选一）】
APP_ENV=dev
# 应用名称（管理后台标题/文档标题）。【适用：全部】
APP_NAME=景区导览AI数字人
# 调试模式：dev=true（详细日志/错误堆栈/热重载）；staging/prod 必须 false。
# 【适用：dev=true；staging/prod=false】
DEBUG=false
# SQLite 数据库连接串（Alembic 管理 schema，见 doc/alembic-migrations.md；
# 备份策略见 doc/database-backup.md 与 scripts/backup_db.sh）。
# Docker 部署保持默认即可（docker-compose volume 挂载 ./digitalHumanApi:/app
# 对应容器内 /app/digital_human.db）。【适用：全部】
DATABASE_URL=sqlite+aiosqlite:///./digital_human.db

# ─────────────────────── 二、对话 LLM 与对话引擎 ───────────────────────
# 对话主链路为 deepagents 装配层（A3 起），模型接入统一走 app/core/llm.py 工厂
# （LLM_* 配置；与 Embedding EMBEDDING_*、运营分析 OPENAI_* 完全独立）。
# 主端点：opencode-go（OpenAI 兼容，https://opencode.ai/zen/go/v1，模型
# deepseek-v4-flash）。兼容性结论（DeepSeek reasoning_content 思考格式）见
# doc/llm-adapter-smoke-test.md：reasoning_content 由 langchain-openai 自动
# 剥离；max_tokens 经工厂 extra_body 注入原生 max_tokens 字段。
# 【适用：全部；dev 可留空 LLM_API_KEY 走 Dify 回落，staging/prod 必填真实 key】
LLM_API_BASE=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-your-opencode-go-api-key
LLM_MODEL=deepseek-v4-flash
# 备用端点（船长决策 2026-08-06）：备用同主端点 opencode-go——opencode 服务
# 本质转发 DeepSeek 官方 key，无需另配官方备用。【适用：同主端点】
LLM_FALLBACK_API_BASE=https://opencode.ai/zen/go/v1
LLM_FALLBACK_API_KEY=sk-your-opencode-go-api-key
LLM_FALLBACK_MODEL=deepseek-v4-flash
# 对话默认采样温度（可被调用方覆盖），默认 0.7。【适用：全部】
LLM_TEMPERATURE=0.7
# 对话引擎（阶段1 T2：LangChain agent 主链路 + Dify 兜底）：
#   langchain（默认）：deepagents 装配层（LLM_* + 本地工具 + 记忆四工具 +
#     GPS 两工具），异常自动回落 Dify（演示不翻车）
#   dify：强制走 Dify Chat Agent（原链路，RAG 预检索 + Dify）
# streaming=true 时返回 SSE 流式事件（agent 步骤 + 逐字回答，ADH 前端消费）。
# 【适用：全部（staging/prod 如需纯 Dify 演示可切 dify）】
DIALOGUE_ENGINE=langchain

# —— 对话成本/速度调优（A4 组合拳，见 doc/deepagents-tuning.md）——
# 1) 单轮工具调用上限：超限后拦截并以错误结果回给模型，模型基于已有信息
#    优雅作答（不报错、不回落）。A1/A4 实测复杂任务 avg 11/peak 14，15 全程
#    未触发，保留作病态循环保险。【适用：全部】
AGENT_MAX_TOOL_CALLS=15
# 2) 工具结果归一化缓存（同 query 不重查；静态数据长缓存 + 知识短 TTL +
#    索引重建即时失效）。【适用：全部】
AGENT_TOOL_CACHE_ENABLED=true
AGENT_TOOL_CACHE_TTL_STATIC=3600
AGENT_TOOL_CACHE_TTL_KNOWLEDGE=300
# 3) 长会话上下文压缩（回答后触发）：历史超过 TRIGGER 条（≈12 轮）时压缩
#    早期轮次为摘要，保留最近 KEEP 条完整消息（≈5 轮）。【适用：全部】
AGENT_COMPACT_ENABLED=true
AGENT_COMPACT_TRIGGER_MESSAGES=24
AGENT_COMPACT_KEEP_MESSAGES=10

# 阶段3 T1 双模式（仅对已弃用的 chat_agent 双模式链路生效，主链路不读取本
# 开关）：true=弃用链路按意图分类分流（简单走快速路径、复杂走规划图）；
# false=全部走快速路径（行为与阶段2 完全一致）。【适用：全部（保留默认）】
AGENT_DUAL_MODE=true

# ─────────────────────────── 三、Embedding（RAG 向量化） ───────────────────────────
# 本地 RAG 知识库的向量化（app/core/embedding.py；与 LLM_*/OPENAI_* 完全独立）。
# EMBEDDING_API_STYLE 控制请求体格式（2026-08-07 起支持 Qwen/DashScope 迁移）：
#   minimax（默认，兼容旧配置）：Minimax 原生格式 {"model","texts","type"}
#     （type=query/db），响应 {"vectors": [...]}；实测 embo-01
#   openai：OpenAI 兼容格式 {"model","input":[...]}，响应 {"data":[...]}；
#     DashScope compatible-mode 实测模型 qwen3.7-text-embedding（1024 维），
#     端点 https://dashscope.aliyuncs.com/compatible-mode/v1
# 不配置 EMBEDDING_API_KEY 时自动降级本地 TF-IDF 向量化（日志告警不中断）。
# 【适用：全部；dev 可留空走 TF-IDF，staging/prod 建议配置真实 key（索引质量）】
EMBEDDING_API_BASE=https://api.minimaxi.com/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=embo-01
EMBEDDING_API_STYLE=minimax

# ─────────────────────────── 四、运营分析（AI 分析） ───────────────────────────
# LangChain AI 运营分析（analytics_service.py）：LLM 失败/未配置/输出不可解析
# 时自动回退纯 DB 统计（llm_analysis 降级标记，接口不中断）。
# 船长决策 2026-08-06：当前部署单用 opencode-go 端点（同对话 LLM 的 key），
# 模型用 deepseek-v4-flash（默认 gpt-4o-mini 仅作通用示例）。
# 【适用：全部；不配置则分析接口稳定回退 DB 统计（staging/prod 建议配置）】
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────── 五、Dify（双轨回落 + 历史数据） ───────────────────────────
# 阶段4 收官：Dify 依赖面仅剩两类（见 doc/dify-dependency-audit.md）：
#   1. 对话双轨回落（保留，演示兜底）：dialogue.py _call_dify_chat 兜底
#   2. 历史数据接口（保留）：polling.py 30s 轮询拉对话入库 + backfill.py 补拉
# DIFY_LIGHT4AI_USER：轮询用户（逗号分隔可多个；留空则轮询空转）
# 【适用：全部（config 校验器要求 URL/KEY 非空：dev 可填占位，staging/prod 填
# 真实地址/key，轮询用户与联调/生产环境一致）】
DIFY_API_URL=https://your-dify.example.com/v1
DIFY_API_KEY=your-chat-agent-api-key
DIFY_LIGHT4AI_USER=your-light4ai-user

# ─────────────────────────── 六、高德 GPS ───────────────────────────
# 高德 Web 服务 Key（批次8 B3：GPS 地理编码/路径规划，见 doc/amap-gps-api.md）。
# 演示主推「描述位置 → 地理编码 → 路径规划 → 地图展示」；坐标全部来自高德 API
# （结构化零幻觉）。未配置不阻断对话：对话工具返回 amap_not_configured 错误码。
# 注意：与前端地图渲染的 JS API key（VITE_AMAP_JS_KEY）是两套独立凭据。
# 【适用：dev 可留空；staging（演示主推）/prod 必填】
AMAP_WEB_KEY=your-amap-web-key

# ─────────────────────────── 七、记忆（短期/长期 + RAG 参数） ───────────────────────────
# —— 短期记忆持久化（阶段2 T1：会话历史 SQLite 落盘 + 进程内 TTL 缓存，
#    见 app/core/memory_store.py；登录用户与游客均享，按 conversation_id）——
# 存储文件独立于主库 digital_human.db（标准库 sqlite3，无额外依赖；Docker
# volume 挂载 /app 下即 memory_store.db，备份策略见 doc/database-backup.md）。
# 【适用：全部】
MEMORY_DB_PATH=memory_store.db
# 会话 TTL（天）：滑动窗口每次对话刷新，默认 7 天。【适用：全部】
MEMORY_TTL_DAYS=7
# 过期会话清理周期（秒）：后台任务定期删除（启动立即清理一次），默认 1 小时。
# 【适用：全部】
MEMORY_CLEANUP_INTERVAL_SECONDS=3600

# —— 本地 RAG 知识库（可选，默认值见 app/core/rag.py / app/services/rag_service.py）——
# 命名空间：knowledge（知识库条目）/ documents（doc/景区知识库/ 文档）/
# user_memory（用户长期记忆）。【适用：全部】
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MAX_CONTEXT_LEN=2000

# —— 长期记忆（阶段2 T2：对话后提取用户事实/偏好写入 user_memory 向量库，
#    见 app/services/memory_service.py 与 doc/long-term-memory.md）——
# 记忆提取总开关（游客/匿名永不写记忆）。【适用：全部；prod 可按 LLM 成本关闭】
MEMORY_ENABLED=true
# 每用户记忆条数上限（超限淘汰 timestamp 最旧条目，防膨胀），默认 200。
# 【适用：全部】
MEMORY_MAX_PER_USER=200
# 长期记忆检索注入（阶段2 T3）：对话首轮按 user 检索用户画像注入上下文
# （主链路为轻量摘要注入 + 记忆工具按需检索）。【适用：全部】
MEMORY_INJECT_ENABLED=true
# 注入的记忆最大时效（天）：超过视为陈旧事实不注入，默认 180。【适用：全部】
MEMORY_MAX_AGE_DAYS=180

# ─────────────────────────── 八、LLM token 记账（用量） ───────────────────────────
# 批次7 C5 统一埋点 + 后台批量写库 + 报表 API，权威契约 doc/usage-tracking.md。
# 总开关：关闭后 llm.py 工厂不再包装埋点模型，所有调用零额外开销。
# 【适用：全部（prod 建议开启，成本可视）】
USAGE_TRACKING_ENABLED=true
# 后台批量写库周期（秒）：进程内队列由 flush 循环定时落库，关闭时兜底 flush。
# 【适用：全部】
USAGE_FLUSH_INTERVAL_SECONDS=5
# 进程内队列上限：超出后立即兜底落库（防内存膨胀），默认 2000。【适用：全部】
USAGE_QUEUE_MAX_SIZE=2000
# 流式调用是否请求 usage（stream_options.include_usage）：opencode-go/DeepSeek
# 均支持；若部署到不兼容网关可关闭（关闭后流式调用无 token 明细不记账）。
# 【适用：全部】
USAGE_STREAM_USAGE=true
# 模型单价表（可选，opencode-go 订阅制可留空只记 token 不记钱）：
# 格式 "模型:每百万输入tokens价,每百万输出tokens价"（元），多项分号分隔。
# 例：MODEL_PRICES=deepseek-v4-flash:1.0,2.0;deepseek-chat:1.0,2.0
# 【适用：prod 建议配置（费用归集）；dev/staging 可留空】
MODEL_PRICES=

# ─────────────────────────── 九、安全（CORS/限流/管理端/JWT） ───────────────────────────
# —— CORS 白名单（批次6 C3 安全加固，逗号分隔多个 origin）——
# 默认值（未配置/留空时）：localhost / 127.0.0.1 / 192.168.16.132 × 5173/8001/3000
# （演示环境本机宿主机跨端口访问不锁死）。【适用：dev/staging 默认即可；
# prod 必须显式收紧为实际部署域名】。注意：CORS_ALLOW_CREDENTIALS=true（默认，
# JWT Bearer 透传需要）时白名单不能含通配符 *（Starlette 会把 * 退化为回显任意
# origin = 全放开，启动会直接报错）。
CORS_ORIGINS=http://localhost:5173,http://localhost:8001,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:3000,http://192.168.16.132:5173,http://192.168.16.132:8001,http://192.168.16.132:3000
# 是否允许跨域携带凭证（Cookie/Authorization），默认 true；仅当显式关闭时才
# 允许 CORS_ORIGINS 使用通配符 *（生产无凭证场景可选）。【适用：全部】
CORS_ALLOW_CREDENTIALS=true

# —— 认证端点限流（批次6 C3，进程内实现零新依赖，见 app/core/rate_limiter.py）——
# 仅作用于 /api/v1/auth/login|register|guest（防爆破），不误伤对话等正常接口；
# 按 IP + 账号双维度：滑动窗口内失败次数达到阈值后进入冷却期，冷却期内 429
# （detail 含剩余秒数 + Retry-After 头）；登录成功自动清零防误伤。
# 【适用：全部；staging/prod 建议收紧（见 doc/deployment-environments.md）】
AUTH_RATE_LIMIT_ENABLED=true
# 窗口内最大失败次数（默认 5 次）
AUTH_RATE_LIMIT_MAX_FAILURES=5
# 失败计数滑动窗口（秒，默认 60）
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# 触发限流后的冷却期（秒，默认 900 = 15 分钟）
AUTH_RATE_LIMIT_COOLDOWN_SECONDS=900
# guest 端点（无失败场景）纯 IP 频率上限：次/分钟（默认 30，防 token 刷取）
AUTH_GUEST_MAX_PER_MINUTE=30

# —— 管理端认证（X-Admin-Token 请求头 + 账号密码登录）——
# 管理员 API Token：既有配置，恒视为 admin 角色（向后兼容）。
# 【适用：dev 可占位；staging/prod 必填随机长串】
ADMIN_API_TOKEN=your-admin-api-token
# 管理端 RBAC 角色映射（批次6 C3，可选）："token1=admin,token2=operator" 逗号
# 分隔；不带 = 的裸 token 视为 admin；ADMIN_TOKENS 命中优先于 ADMIN_API_TOKEN。
# 角色分级：admin 全部操作；operator 查询/公告发布等常规操作，删除类敏感操作
# （知识库删除/记忆删除）403。【适用：dev/staging 可省；prod 建议配多角色】
ADMIN_TOKENS=your-admin-token=admin,your-operator-token=operator
# 管理员账号密码登录（批次9，2026-08-10 船长指示：替代 X-Admin-Token 输入形式）：
# POST /api/v1/admin/login 校验后签发管理员 JWT，管理端接口同时接受
# Authorization Bearer 管理员 JWT 与 X-Admin-Token（双路径任一放行）。
# 默认值为演示环境账号（README「访问入口」已注明）；生产必须修改！
# 【适用：dev/staging 可用默认演示值；prod 必填强密码】
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# 管理员 agent（批次6 B4）：删除类工具两阶段二次确认的待确认项 TTL（秒），
# 首次删除仅登记待确认项，短 TTL 过期后需重新发起（默认 120）。【适用：全部】
ADMIN_AGENT_CONFIRM_TTL_SECONDS=120

# —— JWT 用户认证（注册/登录/游客 token，见 app/core/security.py）——
# JWT_SECRET：生产环境必须设置为随机长字符串（如
#   `python -c "import secrets; print(secrets.token_urlsafe(48))"`）；
# 留空时后端启动生成随机临时密钥，重启后已签发 token 失效（仅限开发）。
# 【适用：dev 可留空；staging/prod 必填】
JWT_SECRET=
# 登录用户 token 有效期（分钟），默认 1440（24 小时）。【适用：全部】
JWT_EXPIRES_MINUTES=1440
# 游客 token 有效期（分钟），短期即可，默认 30。【适用：全部】
GUEST_TOKEN_EXPIRES_MINUTES=30

# ─────────────────────────── 十、SSH（内部联调运维） ───────────────────────────
# 远程服务器连接信息（部署/联调脚本使用）。【适用：dev/staging 联调用；
# prod 不依赖（安全考虑可不配）】
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your-password
