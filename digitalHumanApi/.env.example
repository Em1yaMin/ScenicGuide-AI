# FastAPI 应用配置
APP_NAME=景区导览AI数字人
DEBUG=false

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./digital_human.db

# CORS（开发环境前端地址，多个用英文逗号分隔）
CORS_ORIGINS=http://localhost:5173

# Dify API（骨架阶段占位，P0 功能开发时填写）
DIFY_API_URL=https://your-dify.example.com/v1
DIFY_API_KEY=your-dify-api-key

# SSH 远程服务器
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your-password
