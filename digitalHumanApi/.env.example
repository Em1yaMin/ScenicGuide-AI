# FastAPI 应用配置
APP_NAME=景区导览AI数字人
DEBUG=false

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./digital_human.db

# CORS（开发环境前端地址，多个用英文逗号分隔）
CORS_ORIGINS=http://localhost:5173

# Dify API
# DIFY_API_KEY: Chat Agent 应用的 Key（用于 /conversations、/messages 拉对话）
# DIFY_WORKFLOW_API_KEY: Workflow 应用的 Key（用于 /workflows/run 触发量化评估）
# DIFY_LIGHT4AI_USER: light4ai 调 Dify 时传的 user 字段（固定值，所有对话归此 user）
DIFY_API_URL=https://your-dify.example.com/v1
DIFY_API_KEY=your-chat-agent-api-key
DIFY_WORKFLOW_API_KEY=your-workflow-api-key
DIFY_RECOMMEND_WORKFLOW_API_KEY=app-xxxxxxxxxxxxxxxx
DIFY_LIGHT4AI_USER=your-light4ai-user

# OpenAI（用于 LangChain AI 运营分析）
# 不配置时分析接口回退到纯 DB 统计
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini

# RAG 向量化 Embedding（Minimax OpenAI 兼容端点，与上方 OPENAI_* 完全独立）
# 文档: https://platform.minimaxi.com/document/embeddings
# 不配置 EMBEDDING_API_KEY 时自动降级为本地 TF-IDF 向量化（日志告警，链路不中断）
EMBEDDING_API_BASE=https://api.minimaxi.com/v1
EMBEDDING_API_KEY=your-minimax-api-key
EMBEDDING_MODEL=embedding-1

# 管理员 API Token（管理后台接口认证）
ADMIN_API_TOKEN=your-admin-api-token

# JWT 用户认证（注册/登录/游客 token，见 app/core/security.py）
# JWT_SECRET: 生产环境必须设置为随机长字符串
#   （如 `python -c "import secrets; print(secrets.token_urlsafe(48))"`）；
#   留空时后端启动会生成随机临时密钥，重启后已签发 token 失效（仅限开发）
JWT_SECRET=
# 登录用户 token 有效期（分钟），默认 1440（24 小时）
JWT_EXPIRES_MINUTES=1440
# 游客 token 有效期（分钟），短期即可，默认 30
GUEST_TOKEN_EXPIRES_MINUTES=30

# 本地 RAG 知识库（可选，默认值见 app/core/rag.py / app/services/rag_service.py）
# 命名空间: knowledge（知识库条目）/ documents（doc/景区知识库/ 文档）/ user_memory（用户长期记忆）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MAX_CONTEXT_LEN=2000

# SSH 远程服务器
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your-password
