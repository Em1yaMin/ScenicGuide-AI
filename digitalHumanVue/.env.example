# 数字人前端环境变量
# 复制此文件为 .env 并根据实际环境修改

# 数字人 iframe 服务地址（light4ai）
VITE_LIGHT4AI_URL=

# 后端 API 基础地址（Vite 开发代理目标）
VITE_API_BASE=http://localhost:8000

# 数字人 iframe 的 origin，用于 postMessage 安全校验（可选，默认 *）
VITE_ADH_IFRAME_ORIGIN=

# 默认 Live2D 模型（大小写敏感，须与 ADH public/characters/ 目录名一致）
VITE_LIVE2D_MODEL=Hiyori
