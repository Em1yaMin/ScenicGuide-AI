# 数字人前端环境变量
# 复制此文件为 .env 并根据实际环境修改

# ADH 后端端口（主后端为 8000，数字人后端使用 8001 避免冲突）
NEXT_PUBLIC_ADH_SERVER_PORT=8001

# 高德地图 JS API 凭据（批次8 B3：对话中路线展示）
# 说明：任务约定变量名为 VITE_AMAP_JS_KEY/VITE_AMAP_SECURITY_CODE，
# 但 Next.js 客户端仅注入 NEXT_PUBLIC_ 前缀变量，故按 Next.js 环境约定
# 命名为 NEXT_PUBLIC_AMAP_*（含义一一对应）：
#   VITE_AMAP_JS_KEY          → NEXT_PUBLIC_AMAP_JS_KEY（高德 JS API key）
#   VITE_AMAP_SECURITY_CODE   → NEXT_PUBLIC_AMAP_SECURITY_CODE（安全密钥）
# key 由船长提供，写入 web/.env（已 gitignore，不入库）；未配置时对话
# 不受影响——路线卡片自动降级为文字路线（步骤列表 + 距离时长）。
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
