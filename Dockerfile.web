# Stage 1: Build
FROM node:22-alpine AS build

WORKDIR /app

COPY digitalHumanVue/package.json digitalHumanVue/package-lock.json ./
RUN npm ci

COPY digitalHumanVue/ .

# build-only skips vue-tsc (run locally before docker build)
RUN npm run build-only

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built assets
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
